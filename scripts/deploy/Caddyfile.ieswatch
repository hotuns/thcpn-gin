# Merge these site blocks into the host Caddyfile. Replace the existing
# insitueco.com / www.insitueco.com blocks; preserve every unrelated service.
# Caddy manages HTTPS certificates once DNS and ports 80/443 are ready.
ieswatch.com {
	reverse_proxy 127.0.0.1:5173
}

www.ieswatch.com {
	redir https://ieswatch.com{uri} permanent
}

# Keep existing bookmarks, printed QR codes and shared links working.
insitueco.com, www.insitueco.com {
	redir https://ieswatch.com{uri} permanent
}
