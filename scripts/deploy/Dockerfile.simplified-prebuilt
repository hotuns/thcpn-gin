FROM alpine:3.22 AS backend
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY bin/ /usr/local/bin/
COPY docs/ /app/docs/
CMD ["api"]

FROM nginx:1.30.6 AS platform
COPY frontend/platform/ /usr/share/nginx/html/
COPY nginx-platform.conf /etc/nginx/conf.d/default.conf

FROM nginx:1.30.6 AS admin
RUN mkdir -p /usr/share/nginx/html/admin
COPY frontend/admin/ /usr/share/nginx/html/admin/
COPY nginx-admin.conf /etc/nginx/conf.d/default.conf
