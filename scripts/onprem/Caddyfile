{
	auto_https off
}

:80 {
	encode gzip zstd

	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy api:8080
	}

	redir /admin /admin/ 308

	handle_path /admin/* {
		root * /srv/site/admin
		@adminAssets path /assets/*
		header @adminAssets Cache-Control "public, max-age=31536000, immutable"
		@adminHtml path / /index.html
		header @adminHtml Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/site
		@platformAssets path /assets/*
		header @platformAssets Cache-Control "public, max-age=31536000, immutable"
		@platformHtml path / /index.html
		header @platformHtml Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
