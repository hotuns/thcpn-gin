# IES Watch Lite 单机私有化部署配置模板
# 复制为 site.env 后填写对应参数，再执行 ./install.sh

# ---- 网络与访问地址 ----
SITE_BIND_IP=0.0.0.0
SITE_WEB_PORT=80
PLATFORM_PUBLIC_URL=http://127.0.0.1

# ---- 数据库与安全密钥（留空时 install.sh 自动生成强随机值）----
POSTGRES_USER=thcpn
POSTGRES_PASSWORD=
POSTGRES_DB=thcpn_platform
JWT_SECRET=
ADMIN_JWT_SECRET=

# ---- 单空间标识（留空时 install.sh 自动生成 UUID v4）----
DEPLOYMENT_WORKSPACE_ID=
INIT_WORKSPACE_NAME=默认观测站

# ---- 初始管理员与平台用户（首次安装必填，后续重跑保持幂等）----
INIT_ADMIN_NAME=系统管理员
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=ChangeMe123!
INIT_USER_NAME=平台用户
# 留空时默认与管理员邮箱和密码一致
INIT_USER_EMAIL=
INIT_USER_PASSWORD=

# ---- 地图底图（构建精简前端时使用；私有化服务器具备外网可直接使用天地图）----
VITE_TIANDITU_TOKEN=

# ---- 后端镜像名（可选）----
IESWATCH_IMAGE=ieswatch-lite:latest

# ---- 可选外部设备/媒体对接参数（按实际接入设备类型配置）----
# EZVIZ_APP_KEY=
# EZVIZ_APP_SECRET=
# THCPN_LOG_OSS_PROVIDER=oss
# THCPN_LOG_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
