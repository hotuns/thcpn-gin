POSTGRES_USER=thcpn
POSTGRES_PASSWORD=thcpn_dev_password
POSTGRES_DB=thcpn_platform
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_CONCURRENCY=5

SERVER_ADDR=:8080
PLATFORM_DATABASE_DSN=postgres://thcpn:thcpn_dev_password@127.0.0.1:5432/thcpn_platform?sslmode=disable

OBJECT_STORE_PROVIDER=file
OBJECT_STORE_ENDPOINT=127.0.0.1:8080
OBJECT_STORE_BUCKET=iot-platform
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_LOCAL_PATH=var/objectstore
OBJECT_STORE_PUBLIC_URL_PREFIX=https://iot-datas.oss-cn-beijing.aliyuncs.com
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

JWT_SECRET=dev-insecure-change-me
AUTH_ACCESS_TOKEN_TTL_MINUTES=1440
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_DEV_USER_HEADER_ENABLED=true
AUTH_DEV_REGISTER_ENABLED=true
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_PASSWORD_FAILED_ATTEMPT_LIMIT=5
AUTH_PASSWORD_LOCK_MINUTES=15

SMS_PROVIDER=log
SMS_CODE_TTL_SECONDS=300
SMS_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT=10
SMS_MAX_VERIFY_ATTEMPTS=5
SMS_TEMPLATE_PARAM_CODE_KEY=code

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

TRACING_ENABLED=false
TRACING_SERVICE_NAME=thcpn-gin
TRACING_EXPORTER=stdout
TRACING_OTLP_ENDPOINT=localhost:4318
TRACING_OTLP_INSECURE=true

# THCPN legacy MySQL source. Use this env name as the DataSource secret ref when syncing THCPN devices.
THCPN_STANDARD_STATION_MYSQL_DSN=

# Ezviz / Hikvision camera live preview. Keep app secrets in environment variables, not in frontend code.
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
EZVIZ_OPEN_API_DOMAIN=https://open.ys7.com
EZVIZ_ACCESS_TOKEN_TTL_SECONDS=3600
